# The whole app is admin-only, not just its views: an app that shows an empty
# launcher entry to analysts is still an app that exists, and half a secret is
# a hint. This is the metadata equivalent of Manage Apps -> Permissions ->
# Read: admin, sc_admin.
#
# The REST endpoints this app's pages call are guarded separately, by
# capability, in the riskability app's restmap.conf and authorize.conf. The
# UI restriction is ergonomics; the capability is the control. A user who
# somehow reached these pages in a browser could look at them, but every
# request they could send would come back 403.
[app/ui]
access = read : [ admin, sc_admin ], write : [ admin ]
export = none

[views]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = none
