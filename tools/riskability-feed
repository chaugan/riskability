def cmd_sources(args) -> int:
    print("OSV ecosystem archives (https://osv.dev, per-source licences)\n")
    print(f"  {'ECOSYSTEM':<14} {'SIZE':>10}  COVERS")
    for eco, desc in KNOWN_ECOSYSTEMS.items():
        size = _head_size(osv_url(eco)) if args.check else None
        print(f"  {eco:<14} {_human(size):>10}  {desc}")
    print("\nOverlays\n")
    for name, url in (("CISA KEV", KEV_URL), ("EPSS", EPSS_URL)):
        size = _head_size(url) if args.check else None
        print(f"  {name:<14} {_human(size):>10}  {url}")
    if not args.check:
        print("\n(pass --check to query live sizes)")
    return 0


def _iter_osv_zip(raw: bytes) -> Iterable[dict]:
    with zipfile.ZipFile(io.BytesIO(raw)) as z:
        for info in z.infolist():
            if info.is_dir() or not info.filename.endswith(".json"):
                continue
            with z.open(info) as fh:
                try:
                    yield json.loads(fh.read().decode("utf-8"))
                except (json.JSONDecodeError, UnicodeDecodeError):
                    continue


def _read_single_csv_from_zip(raw: bytes) -> str:
    """Return the one CSV inside a zip. MITRE serves zips named .csv."""
    with zipfile.ZipFile(io.BytesIO(raw)) as z:
        for info in z.infolist():
            if info.filename.lower().endswith(".csv"):
                with z.open(info) as fh:
                    return fh.read().decode("utf-8", errors="replace")
    raise ValueError("no CSV inside the archive")


def _fetch_csv(url: str) -> str:
    """Fetch a CSV that may or may not actually be a zip.

    MITRE serves CAPEC at a .csv URL that is really a zip archive, so sniff the
    magic bytes rather than trusting the extension.
    """
    with _open(url) as r:
        raw = r.read()
    if raw[:2] == b"PK":
        return _read_single_csv_from_zip(raw)
    return raw.decode("utf-8", errors="replace")


def cmd_build(args) -> int:
    ecosystems = args.ecosystem or []
    if not ecosystems and not (args.kev or args.kev_file or args.epss
                               or args.nvd or args.mitre):
        print("error: name at least one --ecosystem (see 'riskability-feed sources')",
              file=sys.stderr)
        return 2

    sources: List[dict] = []
    writer = feedlib.BundleWriter(args.out, sources)

    seen_advisories: Dict[str, dict] = {}
    n_ranges = 0
    n_notaffected = 0

    for eco in ecosystems:
        url = osv_url(eco)
        print(f"fetching {eco:<14} {url}", file=sys.stderr)
        try:
            with _open(url) as r:
                raw = r.read()
        except urllib.error.HTTPError as exc:
            print(f"  ERROR {exc.code} {exc.reason} - skipping {eco}", file=sys.stderr)
            continue
        except Exception as exc:
            print(f"  ERROR {exc} - skipping {eco}", file=sys.stderr)
            continue

        count = 0
        for record in _iter_osv_zip(raw):
            if record.get("withdrawn") and not args.include_withdrawn:
                # A withdrawn advisory must not keep producing findings.
                continue
            try:
                advisory, ranges, notaffected = feedlib.normalize_osv(
                    record, feed_source=f"osv:{eco}"
                )
            except feedlib.FeedError:
                continue
            # One advisory can appear in several ecosystems; keep the first and
            # let the range rows carry the per-ecosystem detail.
            if advisory["advisory_id"] not in seen_advisories:
                seen_advisories[advisory["advisory_id"]] = advisory
            for row in ranges:
                writer.add_range(row)
                n_ranges += 1
            for row in notaffected:
                writer.add_notaffected(row)
                n_notaffected += 1
            count += 1

        print(f"  {count} advisories, {len(raw)} bytes", file=sys.stderr)
        sources.append({
            "name": f"osv:{eco}",
            "url": url,
            "fetched_at": int(time.time()),
            "records": count,
            "licence": "per-record; see OSV source attribution",
        })

    # NVD: CPE-keyed ranges for unmanaged software, and CWE for MITRE mapping.
    cwe_by_cve: Dict[str, List[str]] = {}
    if args.nvd:
        years = _nvd_years(args.nvd)
        api_key = os.environ.get("NVD_API_KEY", "").strip()
        print(f"fetching NVD          {args.nvd_source}, {years[0]}-{years[-1]}",
              file=sys.stderr)
        n_cve = n_ranges = 0
        try:
            for item in feedlib.iter_nvd(
                    years=years, api_key=api_key, source=args.nvd_source,
                    log=lambda m: print(m, file=sys.stderr)):
                try:
                    advisory, ranges, _ = feedlib.normalize_nvd(item, feed_source="nvd")
                except feedlib.FeedError:
                    continue
                if advisory.get("cwes"):
                    cwe_by_cve[advisory["cve_id"]] = advisory["cwes"]
                # NVD never outranks a distro or ecosystem advisory, so it only
                # fills in advisories nothing else described.
                if advisory["advisory_id"] not in seen_advisories:
                    seen_advisories[advisory["advisory_id"]] = advisory
                else:
                    # Keep the CWE list even when another source owns the row.
                    seen_advisories[advisory["advisory_id"]].setdefault(
                        "cwes", advisory["cwes"])
                for row in ranges:
                    writer.add_range(row)
                    n_ranges += 1
                n_cve += 1
        except Exception as exc:
            print(f"  ERROR {exc}", file=sys.stderr)
        print(f"  NVD: {n_cve} CVEs, {n_ranges} CPE ranges", file=sys.stderr)
        sources.append({"name": "nvd", "url": feedlib.NVD_API_URL,
                        "fetched_at": int(time.time()), "records": n_cve,
                        "licence": "NIST/NVD; US Government work. Not endorsed by NVD."})

    # MITRE: the CWE -> CAPEC -> ATT&CK chain, each hop a published mapping,
    # plus the ATT&CK STIX bundle for the tactic each technique belongs to.
    #
    # The STIX half is not optional decoration. Without it every attack row is
    # written with no tactics, the bundle imports perfectly happily, every
    # technique panel works -- and the ATT&CK matrix is blank, because a matrix
    # needs both axes. This tool omitted it entirely for a while, so every
    # bundle built the documented way had an empty matrix and the only clue was
    # a panel that looked like it was reporting no exposure.
    if args.mitre:
        print(f"fetching MITRE CWE    {CWE_URL}", file=sys.stderr)
        try:
            cwe_csv = _fetch_csv(CWE_URL)
            cwe_capec = feedlib.parse_cwe_capec(cwe_csv)
            cwe_abstraction, cwe_parents = feedlib.parse_cwe_hierarchy(cwe_csv)
            print(f"  {len(cwe_capec)} CWEs with attack patterns", file=sys.stderr)
            print(f"fetching MITRE CAPEC  {CAPEC_URL}", file=sys.stderr)
            capec_attack = feedlib.parse_capec_attack(_fetch_csv(CAPEC_URL))
            print(f"  {len(capec_attack)} CAPECs mapped to ATT&CK", file=sys.stderr)

            technique_meta, tactic_rows = {}, []
            print(f"fetching ATT&CK STIX  {ATTACK_STIX_URL}", file=sys.stderr)
            try:
                with _open(ATTACK_STIX_URL) as r:
                    technique_meta, tactic_rows = feedlib.parse_attack_stix(
                        r.read().decode("utf-8"))
                for row in tactic_rows:
                    writer.add_tactic(row)
                print(f"  {len(technique_meta)} techniques, {len(tactic_rows)} tactics",
                      file=sys.stderr)
                sources.append({"name": "mitre-attack-tactics", "url": ATTACK_STIX_URL,
                                "fetched_at": int(time.time()), "records": len(tactic_rows),
                                "licence": "MITRE ATT&CK; see MITRE terms of use"})
            except Exception as exc:
                print(f"  ERROR {exc}", file=sys.stderr)
                print("  WARNING: no tactic mapping. The ATT&CK matrix will be empty "
                      "in this bundle; every other MITRE panel still works.",
                      file=sys.stderr)

            rows = feedlib.build_attack_rows(cwe_capec, capec_attack, technique_meta)
            inherited = feedlib.build_inherited_attack_rows(rows, cwe_abstraction, cwe_parents)
            for row in rows + inherited:
                writer.add_attack(row)
            print(f"  {len(rows)} direct CWE -> ATT&CK mappings, "
                  f"{len(inherited)} inherited from a parent CWE", file=sys.stderr)
            sources.append({"name": "mitre-attack", "url": CAPEC_URL,
                            "fetched_at": int(time.time()), "records": len(rows),
                            "licence": "MITRE CWE/CAPEC; see MITRE terms of use"})
            sources.append({"name": "mitre-attack-inherited", "url": CWE_URL,
                            "fetched_at": int(time.time()), "records": len(inherited),
                            "licence": "MITRE CWE hierarchy; see MITRE terms of use"})

            # The KEV to ATT&CK bridge. Independent of the CAPEC chain above and
            # not fatal if it fails: a failed fetch leaves the bridge panel with
            # no data, which it states, while every other panel still works.
            print(f"fetching KEV -> ATT&CK   {KEV_ATTACK_URL}", file=sys.stderr)
            try:
                with _open(KEV_ATTACK_URL) as r:
                    kev_rows = feedlib.parse_kev_attack(r.read().decode("utf-8"))
                for row in kev_rows:
                    writer.add_kevmap(row)
                print(f"  {len(kev_rows)} KEV CVE -> technique mappings", file=sys.stderr)
                sources.append({"name": "mitre-ctid-kev-attack", "url": KEV_ATTACK_URL,
                                "fetched_at": int(time.time()), "records": len(kev_rows),
                                "licence": "Apache 2.0; MITRE Center for Threat-Informed Defense"})
            except Exception as exc:
                print(f"  ERROR {exc} - continuing without the KEV bridge", file=sys.stderr)

            # CAPEC prose, from the catalogue CSV already fetched above. Turns the
            # invisible join hop into "what an attacker needs and does first".
            try:
                capec_rows = feedlib.parse_capec_detail(_fetch_csv(CAPEC_URL))
                for row in capec_rows:
                    writer.add_capec(row)
                print(f"  {len(capec_rows)} CAPEC prose rows", file=sys.stderr)
            except Exception as exc:
                print(f"  ERROR {exc} - continuing without CAPEC prose", file=sys.stderr)

            # ATT&CK mitigations, from the STIX bundle already fetched above.
            try:
                if technique_meta is not None:
                    with _open(ATTACK_STIX_URL) as r:
                        mit_rows = feedlib.parse_attack_mitigations(r.read().decode("utf-8"))
                    for row in mit_rows:
                        writer.add_mitigation(row)
                    print(f"  {len(mit_rows)} ATT&CK mitigation edges", file=sys.stderr)
            except Exception as exc:
                print(f"  ERROR {exc} - continuing without mitigations", file=sys.stderr)
        except Exception as exc:
            print(f"  ERROR {exc} - continuing without MITRE mapping", file=sys.stderr)

    # Overlays enrich advisories that already exist; they never create findings.
    kev: Dict[str, dict] = {}
    if args.kev_file:
        # CISA blocks automated clients from some networks -- a plain 403, on a
        # catalogue that is US-government public domain and free to download in
        # a browser. Rather than lose the single strongest signal the app has
        # over a user-agent policy, take the file somebody downloaded by hand.
        print(f"reading KEV           {args.kev_file}", file=sys.stderr)
        with open(args.kev_file, encoding="utf-8") as fh:
            kev = feedlib.normalize_kev(json.load(fh))
        print(f"  {len(kev)} known-exploited CVEs", file=sys.stderr)
        sources.append({"name": "cisa-kev", "url": os.path.abspath(args.kev_file),
                        "fetched_at": int(time.time()), "records": len(kev),
                        "licence": "US Government work, public domain"})
    elif args.kev:
        print(f"fetching KEV          {KEV_URL}", file=sys.stderr)
        try:
            with _open(KEV_URL) as r:
                kev = feedlib.normalize_kev(json.loads(r.read().decode("utf-8")))
            print(f"  {len(kev)} known-exploited CVEs", file=sys.stderr)
            sources.append({"name": "cisa-kev", "url": KEV_URL,
                            "fetched_at": int(time.time()), "records": len(kev),
                            "licence": "US Government work, public domain"})
        except Exception as exc:
            print(f"  ERROR {exc} - continuing without KEV", file=sys.stderr)
            print("  Download the catalogue in a browser from "
                  "https://www.cisa.gov/known-exploited-vulnerabilities-catalog "
                  "and pass it with --kev-file.", file=sys.stderr)

    epss: Dict[str, dict] = {}
    if args.epss:
        # gzip is imported at module scope. A function-local "import gzip" here
        # would make the name local to the WHOLE function, so the NVD block
        # above -- which also decompresses -- would fail with "cannot access
        # local variable 'gzip'" for every year, and only in builds that also
        # requested EPSS.
        print(f"fetching EPSS         {EPSS_URL}", file=sys.stderr)
        try:
            with _open(EPSS_URL) as r:
                data = gzip.decompress(r.read()).decode("utf-8")
            epss = feedlib.normalize_epss(data.splitlines())
            print(f"  {len(epss)} scored CVEs", file=sys.stderr)
            sources.append({"name": "first-epss", "url": EPSS_URL,
                            "fetched_at": int(time.time()), "records": len(epss),
                            "licence": "FIRST.org EPSS; attribution expected"})
        except Exception as exc:
            print(f"  ERROR {exc} - continuing without EPSS", file=sys.stderr)

    for advisory in seen_advisories.values():
        cve = (advisory.get("cve_id") or "").upper()
        # A CWE learned from NVD applies to the advisory whichever source owns it.
        if cve in cwe_by_cve and not advisory.get("cwes"):
            advisory["cwes"] = cwe_by_cve[cve]
        if cve in kev:
            advisory.update(kev[cve])
        if cve in epss:
            advisory.update(epss[cve])
        writer.add_advisory(advisory)

    # Last, because it is by far the largest fetch: everything above is already
    # written by the time this runs, so a failure here still leaves a usable
    # bundle rather than throwing away an hour of downloads.
    if args.cve_list or args.cve_list_file:
        try:
            if args.cve_list_file:
                blob, origin = args.cve_list_file, args.cve_list_file
            else:
                print(f"fetching CVE Program  {CVELIST_LATEST_API}", file=sys.stderr)
                with _open(CVELIST_LATEST_API) as r:
                    rel = json.loads(r.read().decode("utf-8"))
                asset = next((a for a in rel.get("assets", [])
                              if "all_CVEs" in a.get("name", "")), None)
                if asset is None:
                    raise RuntimeError("no all_CVEs asset in the latest cvelistV5 release")
                origin = asset["browser_download_url"]
                print(f"  {rel.get('tag_name','')}, {asset['size']/1e6:.0f} MB, "
                      f"this takes a while", file=sys.stderr)
                blob = os.path.join(tempfile.gettempdir(), "riskability-cvelist.zip")
                with _open(origin) as r, open(blob, "wb") as fh:
                    shutil.copyfileobj(r, fh, 1024 * 1024)
            kept = 0
            for record in feedlib.iter_cvelist_archive(blob):
                row = feedlib.normalize_cvelist(record)
                if row is None:
                    continue
                writer.write(feedlib.CVEDETAIL_MEMBER, row)
                kept += 1
                if kept % 25000 == 0:
                    print(f"  {kept} CVEs", file=sys.stderr)
            print(f"  {kept} CVEs with a description or a named product", file=sys.stderr)
            sources.append({"name": "cve-program", "url": origin,
                            "fetched_at": int(time.time()), "records": kept,
                            "licence": "CVE Program terms of use, redistribution permitted"})
            if not args.cve_list_file and os.path.exists(blob):
                os.unlink(blob)
        except Exception as exc:
            print(f"  ERROR {exc} - continuing without the CVE Program catalogue",
                  file=sys.stderr)

    manifest = writer.close(bundle_version=args.version or "")

    print(f"\nwrote {args.out}", file=sys.stderr)
    print(f"  bundle_id  {manifest['bundle_id']}", file=sys.stderr)
    print(f"  size       {_human(manifest['size_bytes'])}", file=sys.stderr)
    print(f"  sha256     {manifest['sha256']}", file=sys.stderr)
    print(f"  advisories {manifest['counts']['advisories']}", file=sys.stderr)
    print(f"  ranges     {manifest['counts']['ranges']}", file=sys.stderr)
    print(f"  notaffected{manifest['counts']['notaffected']:>7}", file=sys.stderr)
    return 0


def cmd_inspect(args) -> int:
    manifest = feedlib.read_manifest(args.bundle)
    print(json.dumps(manifest, indent=2, sort_keys=True))
    if args.sample:
        print("\n-- sample ranges --")
        for i, row in enumerate(feedlib.iter_member(args.bundle, feedlib.RANGES_NAME)):
            if i >= args.sample:
                break
            print(json.dumps(row, sort_keys=True))
    return 0


def main(argv=None) -> int:
    p = argparse.ArgumentParser(prog="riskability-feed", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("sources", help="list downloadable sources")
    s.add_argument("--check", action="store_true", help="query live sizes")
    s.set_defaults(func=cmd_sources)

    b = sub.add_parser("build", help="download feeds and write a bundle")
    b.add_argument("--out", required=True)
    b.add_argument("--ecosystem", action="append",
                   help="OSV ecosystem, repeatable (e.g. --ecosystem Ubuntu)")
    b.add_argument("--nvd-source", dest="nvd_source", default="auto",
                   choices=["auto", "mirror", "api"],
                   help="auto (default) reads the regenerated bulk feeds and "
                        "tops up from the NIST API; mirror skips the top-up; "
                        "api uses NIST only and takes an hour or more")
    b.add_argument("--nvd", metavar="YEARS", default="",
                   help="include NVD CPE ranges and CWE. YEARS is 'all', a year, "
                        "a range like 2020-2026, or a comma-separated list. "
                        "Needed for Windows and other unmanaged software.")
    b.add_argument("--mitre", action="store_true",
                   help="include the MITRE CWE->CAPEC->ATT&CK mapping")
    b.add_argument("--cve-list", action="store_true",
                   help="include the CVE Program catalogue: descriptions and product "
                        "names for the CVE encyclopaedia. About 600 MB to download and "
                        "roughly 120 MB in the bundle, so it is opt in. Without it the "
                        "encyclopaedia shows only what distribution advisories say, "
                        "which is often an id and a score with no prose at all.")
    b.add_argument("--cve-list-file", default="",
                   help="read the CVE Program catalogue from an already downloaded "
                        "release zip instead of fetching it")
    b.add_argument("--kev", action="store_true", help="include CISA KEV")
    b.add_argument("--kev-file", default="",
                   help="read the CISA KEV catalogue from a local JSON file instead of "
                        "downloading it. Use this when CISA returns 403 to automated "
                        "clients, which it does from some networks.")
    b.add_argument("--epss", action="store_true", help="include EPSS scores")
    b.add_argument("--version", default="", help="bundle version label")
    b.add_argument("--include-withdrawn", action="store_true",
                   help="keep withdrawn advisories (off by default)")
    b.set_defaults(func=cmd_build)

    i = sub.add_parser("inspect", help="print a bundle's manifest")
    i.add_argument("bundle")
    i.add_argument("--sample", type=int, default=0, help="also print N range rows")
    i.set_defaults(func=cmd_inspect)

    args = p.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
