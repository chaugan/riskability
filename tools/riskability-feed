#!/usr/bin/env python3
"""riskability-feed - build an offline vulnerability bundle for the Splunk app.

Run this on a machine that has Internet access, then carry the resulting
bundle to the air-gapped Splunk search head and upload it on the Riskability
admin page.

    riskability-feed build --out riskability-feed.tar.gz \
        --ecosystem Debian --ecosystem Ubuntu --ecosystem Alpine \
        --ecosystem npm --ecosystem PyPI --ecosystem Go --ecosystem Maven \
        --kev --epss

    riskability-feed sources          # what can be fetched, and how big
    riskability-feed inspect FILE     # what is inside a built bundle

Only the sources you name are downloaded. Nothing is bundled with this tool,
and this tool is not part of the Splunk app package: the app itself never makes
a network request.

Licensing: the feeds have different terms. OSV aggregates sources that are
individually CC-BY-4.0 (GitHub, Red Hat), CC-BY-SA-4.0 (Ubuntu), MIT (Alma),
BSD (Rocky) and others; CISA KEV is US-government public domain; EPSS is
published by FIRST and expects attribution. The bundle records which source
each record came from so the attribution survives into Splunk. Building a
bundle for your own organisation is uncontroversial; redistributing one is
your decision to make, not this tool's.
"""

from __future__ import annotations

import argparse
import io
import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import zipfile
from typing import Dict, Iterable, List, Optional

sys.path.insert(
    0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "app", "riskability", "bin")
)

from riskability import feed as feedlib  # noqa: E402

USER_AGENT = "riskability-feed/0.1 (+https://github.com/chaugan/riskability)"

OSV_BASE = "https://storage.googleapis.com/osv-vulnerabilities"
KEV_URL = "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json"
EPSS_URL = "https://epss.empiricalsecurity.com/epss_scores-current.csv.gz"

# Ecosystems worth offering, with the swinv package types they answer for.
KNOWN_ECOSYSTEMS = {
    "Debian":      "deb packages on Debian hosts",
    "Ubuntu":      "deb packages on Ubuntu hosts",
    "Alpine":      "apk packages",
    "Red Hat":     "rpm packages on RHEL",
    "Rocky Linux": "rpm packages on Rocky",
    "AlmaLinux":   "rpm packages on Alma",
    "SUSE":        "rpm packages on SLES",
    "openSUSE":    "rpm packages on openSUSE",
    "npm":         "JavaScript packages",
    "PyPI":        "Python packages",
    "Go":          "Go modules",
    "Maven":       "Java archives",
    "NuGet":       ".NET packages",
    "RubyGems":    "Ruby gems",
    "crates.io":   "Rust crates",
    "Packagist":   "PHP packages",
}


def _open(url: str, timeout: int = 300):
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    return urllib.request.urlopen(req, timeout=timeout)


def _head_size(url: str) -> Optional[int]:
    try:
        req = urllib.request.Request(url, method="HEAD", headers={"User-Agent": USER_AGENT})
        with urllib.request.urlopen(req, timeout=60) as r:
            v = r.headers.get("Content-Length")
            return int(v) if v else None
    except Exception:
        return None


def _human(n: Optional[int]) -> str:
    if n is None:
        return "unknown"
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.1f} {unit}" if unit != "B" else f"{n} B"
        n /= 1024.0
    return f"{n:.1f} GB"


def osv_url(ecosystem: str) -> str:
    return f"{OSV_BASE}/{urllib.parse.quote(ecosystem)}/all.zip"


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def cmd_sources(args) -> int:
    print("OSV ecosystem archives (https://osv.dev, per-source licences)\n")
    print(f"  {'ECOSYSTEM':<14} {'SIZE':>10}  COVERS")
    for eco, desc in KNOWN_ECOSYSTEMS.items():
        size = _head_size(osv_url(eco)) if args.check else None
        print(f"  {eco:<14} {_human(size):>10}  {desc}")
    print("\nOverlays\n")
    for name, url in (("CISA KEV", KEV_URL), ("EPSS", EPSS_URL)):
        size = _head_size(url) if args.check else None
        print(f"  {name:<14} {_human(size):>10}  {url}")
    if not args.check:
        print("\n(pass --check to query live sizes)")
    return 0


def _iter_osv_zip(raw: bytes) -> Iterable[dict]:
    with zipfile.ZipFile(io.BytesIO(raw)) as z:
        for info in z.infolist():
            if info.is_dir() or not info.filename.endswith(".json"):
                continue
            with z.open(info) as fh:
                try:
                    yield json.loads(fh.read().decode("utf-8"))
                except (json.JSONDecodeError, UnicodeDecodeError):
                    continue


def cmd_build(args) -> int:
    ecosystems = args.ecosystem or []
    if not ecosystems and not (args.kev or args.epss):
        print("error: name at least one --ecosystem (see 'riskability-feed sources')",
              file=sys.stderr)
        return 2

    sources: List[dict] = []
    writer = feedlib.BundleWriter(args.out, sources)

    seen_advisories: Dict[str, dict] = {}
    n_ranges = 0
    n_notaffected = 0

    for eco in ecosystems:
        url = osv_url(eco)
        print(f"fetching {eco:<14} {url}", file=sys.stderr)
        try:
            with _open(url) as r:
                raw = r.read()
        except urllib.error.HTTPError as exc:
            print(f"  ERROR {exc.code} {exc.reason} - skipping {eco}", file=sys.stderr)
            continue
        except Exception as exc:
            print(f"  ERROR {exc} - skipping {eco}", file=sys.stderr)
            continue

        count = 0
        for record in _iter_osv_zip(raw):
            if record.get("withdrawn") and not args.include_withdrawn:
                # A withdrawn advisory must not keep producing findings.
                continue
            try:
                advisory, ranges, notaffected = feedlib.normalize_osv(
                    record, feed_source=f"osv:{eco}"
                )
            except feedlib.FeedError:
                continue
            # One advisory can appear in several ecosystems; keep the first and
            # let the range rows carry the per-ecosystem detail.
            if advisory["advisory_id"] not in seen_advisories:
                seen_advisories[advisory["advisory_id"]] = advisory
            for row in ranges:
                writer.add_range(row)
                n_ranges += 1
            for row in notaffected:
                writer.add_notaffected(row)
                n_notaffected += 1
            count += 1

        print(f"  {count} advisories, {len(raw)} bytes", file=sys.stderr)
        sources.append({
            "name": f"osv:{eco}",
            "url": url,
            "fetched_at": int(time.time()),
            "records": count,
            "licence": "per-record; see OSV source attribution",
        })

    # Overlays enrich advisories that already exist; they never create findings.
    kev: Dict[str, dict] = {}
    if args.kev:
        print(f"fetching KEV          {KEV_URL}", file=sys.stderr)
        try:
            with _open(KEV_URL) as r:
                kev = feedlib.normalize_kev(json.loads(r.read().decode("utf-8")))
            print(f"  {len(kev)} known-exploited CVEs", file=sys.stderr)
            sources.append({"name": "cisa-kev", "url": KEV_URL,
                            "fetched_at": int(time.time()), "records": len(kev),
                            "licence": "US Government work, public domain"})
        except Exception as exc:
            print(f"  ERROR {exc} - continuing without KEV", file=sys.stderr)

    epss: Dict[str, dict] = {}
    if args.epss:
        import gzip
        print(f"fetching EPSS         {EPSS_URL}", file=sys.stderr)
        try:
            with _open(EPSS_URL) as r:
                data = gzip.decompress(r.read()).decode("utf-8")
            epss = feedlib.normalize_epss(data.splitlines())
            print(f"  {len(epss)} scored CVEs", file=sys.stderr)
            sources.append({"name": "first-epss", "url": EPSS_URL,
                            "fetched_at": int(time.time()), "records": len(epss),
                            "licence": "FIRST.org EPSS; attribution expected"})
        except Exception as exc:
            print(f"  ERROR {exc} - continuing without EPSS", file=sys.stderr)

    for advisory in seen_advisories.values():
        cve = (advisory.get("cve_id") or "").upper()
        if cve in kev:
            advisory.update(kev[cve])
        if cve in epss:
            advisory.update(epss[cve])
        writer.add_advisory(advisory)

    manifest = writer.close(bundle_version=args.version or "")

    print(f"\nwrote {args.out}", file=sys.stderr)
    print(f"  bundle_id  {manifest['bundle_id']}", file=sys.stderr)
    print(f"  size       {_human(manifest['size_bytes'])}", file=sys.stderr)
    print(f"  sha256     {manifest['sha256']}", file=sys.stderr)
    print(f"  advisories {manifest['counts']['advisories']}", file=sys.stderr)
    print(f"  ranges     {manifest['counts']['ranges']}", file=sys.stderr)
    print(f"  notaffected{manifest['counts']['notaffected']:>7}", file=sys.stderr)
    return 0


def cmd_inspect(args) -> int:
    manifest = feedlib.read_manifest(args.bundle)
    print(json.dumps(manifest, indent=2, sort_keys=True))
    if args.sample:
        print("\n-- sample ranges --")
        for i, row in enumerate(feedlib.iter_member(args.bundle, feedlib.RANGES_NAME)):
            if i >= args.sample:
                break
            print(json.dumps(row, sort_keys=True))
    return 0


def main(argv=None) -> int:
    p = argparse.ArgumentParser(prog="riskability-feed", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("sources", help="list downloadable sources")
    s.add_argument("--check", action="store_true", help="query live sizes")
    s.set_defaults(func=cmd_sources)

    b = sub.add_parser("build", help="download feeds and write a bundle")
    b.add_argument("--out", required=True)
    b.add_argument("--ecosystem", action="append",
                   help="OSV ecosystem, repeatable (e.g. --ecosystem Ubuntu)")
    b.add_argument("--kev", action="store_true", help="include CISA KEV")
    b.add_argument("--epss", action="store_true", help="include EPSS scores")
    b.add_argument("--version", default="", help="bundle version label")
    b.add_argument("--include-withdrawn", action="store_true",
                   help="keep withdrawn advisories (off by default)")
    b.set_defaults(func=cmd_build)

    i = sub.add_parser("inspect", help="print a bundle's manifest")
    i.add_argument("bundle")
    i.add_argument("--sample", type=int, default=0, help="also print N range rows")
    i.set_defaults(func=cmd_inspect)

    args = p.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
