#!/usr/bin/env python3
"""Flatten a swinv scan's exposure and container sections into NDJSON records.

swinv already reports what is listening, what is exposed at the network edge,
and what is inside each container -- but its NDJSON stream carries only
components and the heartbeat, so none of it reaches Splunk. This writes the
records the app expects, in the same one-record-per-line shape, so the two can
be sent down the same pipe.

It exists so the app side can be built and verified against real data while the
collector catches up. Once swinv emits these itself this script is redundant,
which is the point: the record shape below IS the contract.

    exposure   one row per open port per package answering it
    container  one row per container, running or stopped
"""
import json
import sys
import urllib.parse


def component_name(ref: str) -> str:
    """The package name a component reference points at, as the matcher stores it.

    Two shapes arrive here, because the two platforms identify software
    differently and swinv does not pretend otherwise:

      pkg:deb/ubuntu/openssh-server@1%3A10.2p1?arch=amd64  ->  openssh-server
      pkg:golang/github.com/coder/websocket@v1.8.13        ->  github.com/coder/websocket
      Eclipse Mosquitto MQTT broker (64 bit)@2.0.18        ->  Eclipse Mosquitto MQTT broker (64 bit)

    The third is Windows, where there is no package manager to give a PURL and
    the display name is the identity. Splitting on the LAST @ matters there:
    plenty of Windows product names contain one.
    """
    if not ref.startswith("pkg:"):
        return ref.rsplit("@", 1)[0] if "@" in ref else ref
    body = ref[4:].split("?", 1)[0]
    kind, _, rest = body.partition("/")
    name = rest.split("@", 1)[0]
    if kind in ("deb", "rpm", "apk"):          # namespace is the distro, not the name
        name = name.split("/")[-1]
    return urllib.parse.unquote(name)


def emit(rec: dict) -> str:
    """One NDJSON line, with absent fields absent rather than null.

    Splunk indexes a JSON null as the four-character string "null", so a record
    carrying "unit": null gives every listener on that host a unit named "null"
    -- and coalesce() cannot tell the difference. Omitting the key is the same
    statement without the trap.
    """
    return json.dumps({k: v for k, v in rec.items() if v is not None},
                      separators=(",", ":")) + "\n"


def main(src: str, out: str) -> int:
    doc = json.load(open(src, encoding="utf-8"))
    host = doc.get("host") or {}
    scan = doc.get("scan") or {}
    stamp = scan.get("finished_at") or scan.get("started_at") or ""
    hostname = host.get("hostname")

    # Which container publishes which host port, so an exposure row can say so.
    by_endpoint = {}
    for c in doc.get("containers") or []:
        for svc in c.get("services") or []:
            for ep in svc.get("endpoints") or []:
                by_endpoint[ep] = c

    n = 0
    with open(out, "w", encoding="utf-8") as fh:
        for e in doc.get("exposure") or []:
            ep = f"{e.get('address')}:{e.get('port')}/{e.get('protocol')}"
            ctr = by_endpoint.get(ep)
            base = {
                "record_type": "exposure", "hostname": hostname, "scanned_at": stamp,
                "address": e.get("address"), "port": e.get("port"),
                "protocol": e.get("protocol"), "bind_scope": e.get("bind_scope"),
                "executable": e.get("executable"), "unit": e.get("unit"),
                "user": e.get("user"), "processes": e.get("processes"),
                "confidence": e.get("confidence"),
            }
            if ctr:
                base["container_id"] = ctr.get("id")
                base["container_name"] = ctr.get("name")
            comps = e.get("components") or []
            # One row per package answering the port. A port with no package
            # attributed still gets a row: an unattributed listener is a gap in
            # what the app can see, not an absence of risk, and dropping it here
            # would hide it completely.
            for purl in comps or [None]:
                rec = dict(base)
                if purl:
                    rec["purl"] = purl
                    rec["package"] = component_name(purl)
                fh.write(emit(rec))
                n += 1

        for c in doc.get("containers") or []:
            img = c.get("image") or {}
            eps = []
            for svc in c.get("services") or []:
                eps.extend(svc.get("endpoints") or [])
            fh.write(emit({
                "record_type": "container", "hostname": hostname, "scanned_at": stamp,
                "container_id": c.get("id"), "container_name": c.get("name"),
                "runtime": c.get("runtime"), "state": c.get("state"),
                "image_ref": img.get("ref"), "image_digest": img.get("manifest_digest"),
                "image_purl": img.get("purl"),
                "os_id": c.get("os_id"), "os_version_id": c.get("os_version_id"),
                "declared_endpoints": c.get("declared_endpoints") or [],
                "endpoints": eps,
            }))
            n += 1

    print(f"{n} records -> {out}")
    return 0


if __name__ == "__main__":
    if len(sys.argv) != 3:
        print("usage: swinv-exposure-ndjson <scan.json> <out.ndjson>", file=sys.stderr)
        raise SystemExit(2)
    raise SystemExit(main(sys.argv[1], sys.argv[2]))
